{
  "project_id": "YOUR_PROJECT_ID",
  "region": "us-central1",
  "landing_bucket": "gs://YOUR_BUCKET/landing",
  "archive_bucket": "gs://YOUR_BUCKET/archive",
  "quarantine_bucket": "gs://YOUR_BUCKET/quarantine",
  "temp_location": "gs://YOUR_BUCKET/dataflow/temp",
  "staging_location": "gs://YOUR_BUCKET/dataflow/staging",
  "quarantine_table": "YOUR_PROJECT_ID:fitanalytics_audit.quarantine_records",
  "audit_table": "YOUR_PROJECT_ID:fitanalytics_audit.pipeline_audit",
  "entities": {
    "customer": {
      "input": "customer/business_date={business_date}/customer_*.csv",
      "output_table": "YOUR_PROJECT_ID:fitanalytics_stage.stg_customer"
    },
    "product": {
      "input": "product/business_date={business_date}/product_*.csv",
      "output_table": "YOUR_PROJECT_ID:fitanalytics_stage.stg_product"
    },
    "purchase": {
      "input": "purchase/business_date={business_date}/purchase_*.csv",
      "output_table": "YOUR_PROJECT_ID:fitanalytics_stage.stg_purchase"
    },
    "return": {
      "input": "return/business_date={business_date}/return_*.csv",
      "output_table": "YOUR_PROJECT_ID:fitanalytics_stage.stg_return"
    },
    "recommendation": {
      "input": "recommendation/business_date={business_date}/recommendation_*.csv",
      "output_table": "YOUR_PROJECT_ID:fitanalytics_stage.stg_recommendation"
    }
  }
}
